NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_9z5Rqtwei0VIwS6AcHAy9w_HsPlsh_F
NEXT_PUBLIC_ADMIN_SITE_URL=https://popstreet-web.vercel.app

# Server-only Availability Crawler Cloud Run dispatch configuration.
# Required for atomic dispatch reservations. NEVER use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Dispatcher also needs job-scoped run.executions.get/list for safe recovery.
# See docs/availability-crawler-dispatch.md for minimum IAM permissions.
AVAILABILITY_CRAWLER_GCP_PROJECT_ID=your-google-cloud-project-id
AVAILABILITY_CRAWLER_CLOUD_RUN_REGION=us-east1
AVAILABILITY_CRAWLER_CLOUD_RUN_JOB=availability-crawler
# Preferred production authentication: Vercel OIDC + Google Workload Identity Federation.
AVAILABILITY_CRAWLER_GCP_PROJECT_NUMBER=1234567890
AVAILABILITY_CRAWLER_GCP_SERVICE_ACCOUNT_EMAIL=availability-crawler-dispatcher@your-google-cloud-project-id.iam.gserviceaccount.com
AVAILABILITY_CRAWLER_GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
AVAILABILITY_CRAWLER_GCP_WORKLOAD_IDENTITY_PROVIDER_ID=vercel
# Optional legacy compatibility only. Prefer the short-lived OIDC configuration above.
AVAILABILITY_CRAWLER_GCP_SERVICE_ACCOUNT_JSON={"type":"external_account"}
